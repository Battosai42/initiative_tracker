{
  "name": "initiative-tracker",
  "version": "1.0.0",
  "description": "Local initiative and HP tracker for D&D, Starfinder, Shadowrun and Battletech",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "npm run build && npm run preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ttrpg",
    "initiative",
    "dnd",
    "starfinder",
    "shadowrun",
    "battletech"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
